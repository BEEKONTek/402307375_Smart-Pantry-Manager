<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <EditText android:id="@+id/et_name" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient name (e.g. tomato)" android:inputType="text"/>
    <EditText android:id="@+id/et_qty" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity (e.g. 2)" android:inputType="numberDecimal"/>
    <EditText android:id="@+id/et_unit" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit (g, ml, each, tsp…)" android:inputType="text"/>
    <EditText android:id="@+id/et_expiry" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Expiry date yyyy-MM-dd (optional)" android:inputType="date"/>
    <Button android:id="@+id/btn_save" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Save"/>
    <Button android:id="@+id/btn_cancel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Cancel"/>
</LinearLayout>