<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp"
    android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_qty" android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tv_expiry" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/btn_delete" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Delete" android:padding="8dp"/>
</LinearLayout>